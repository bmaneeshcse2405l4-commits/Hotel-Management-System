# Copy this file to .env and fill in your local values
# DO NOT commit .env to git

SECRET_KEY=your-local-dev-secret-key

# For local development (SQLite - zero setup)
DATABASE_URL=sqlite:///hotel.db

# For local MySQL (uncomment and fill in if using MySQL locally)
# DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/hotel_db

# Render injects DATABASE_URL automatically from the PostgreSQL database
FLASK_ENV=development
